# Local standalone mongod works for everything except multi-document transactions.
# For transactions (invitation accept), use Atlas or run local with a replica set:
#   mongod --replSet rs0   then in mongosh:  rs.initiate()
MONGODB_URI="mongodb://127.0.0.1:27017/mothership"

APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="mothership_session"

# Bootstrap super admin — used once by `npm run seed`, then may be removed.
SUPER_ADMIN_EMAIL="owner@example.com"
SUPER_ADMIN_PASSWORD="change-me-now"
SUPER_ADMIN_NAME="Owner"
